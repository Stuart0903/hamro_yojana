// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// ENUMS
//////////////////////

enum ProfileStatus {
  COMPLETE
  INCOMPLETE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentType {
  SELF_EMPLOYED
  PRIVATE
  GOVERNMENT
  STUDENT
  UNEMPLOYED
}

enum EducationLevel {
  NONE
  PRIMARY
  SECONDARY
  TERTIARY
  POSTGRADUATE
}

enum DocumentType {
  CITIZENSHIP
  PASSPORT
  NID
  LICENSE
  OTHER
}

enum JurisdictionLevel {
  NATIONAL
  PROVINCE
  DISTRICT
  MUNICIPALITY
  WARD
}

enum RoleType {
  SUPER_ADMIN
  MINISTRY_OFFICER
  PROVINCE_OFFICER
  DISTRICT_OFFICER
  MUNICIPALITY_OFFICER
  WARD_OFFICER
  CITIZEN
}

enum RequirementType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  DOCUMENT
  IMAGE
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFICATION_PENDING
  APPROVED
  REJECTED
  DISBURSED
}

enum SchemeCategory {
  EDUCATION
  HEALTH
  AGRICULTURE
  WOMEN
  YOUTH
  DISABILITY
  EMPLOYMENT
  SOCIAL_SECURITY
  BUSINESS
  HOUSING
}

enum SchemeStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  CLOSED
}

//////////////////////////////////////////////////////
// JURISDICTION
//////////////////////////////////////////////////////
model Province {
  id        String     @id @default(uuid())
  name      String     @unique
  districts District[]

  addresses Address[]

  officeProfile OfficeProfile[]
}

model District {
  id         String   @id @default(uuid())
  name       String
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  municipalities Municipality[]
  addresses      Address[]
  officeProfile  OfficeProfile[]

  @@unique([name, provinceId])
}

model Municipality {
  id         String   @id @default(uuid())
  name       String
  type       String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  wards         Ward[]
  addresses     Address[]
  officeProfile OfficeProfile[]

  @@unique([name, districtId])
}

model Ward {
  id             String          @id @default(uuid())
  wardNumber     Int
  municipalityId String
  municipality   Municipality    @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  addresses      Address[]
  officeProfile  OfficeProfile[]

  @@unique([wardNumber, municipalityId])
}

//////////////////////
// Roles and Permissions
//////////////////////
model Role {
  id        String   @id @default(uuid())
  name      RoleType @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  userRoles UserRole[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

//////////////////////
// MODELS
//////////////////////

model User {
  uid             String  @id @default(cuid())
  username        String?
  email           String? @unique
  phoneNumber     String? @unique
  passwordHash    String
  isPhoneVerified Boolean @default(false)

  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  refreshTokens   refreshToken[]
  userRoles       UserRole[]

  citizenProfile CitizenProfile?
  officeProfile  OfficeProfile?
}

model OTPVerification {
  id          String   @id @default(cuid())
  phoneNumber String
  otpCode     String
  purpose String?
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  attempt Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([phoneNumber, purpose])
}

model refreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
}

model CitizenProfile {
  id     String @id @default(cuid())
  userId String @unique

  profileStatus      ProfileStatus      @default(INCOMPLETE)
  verificationStatus VerificationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Relations
  user            User             @relation(fields: [userId], references: [uid], onDelete: Cascade)
  personalDetails PersonalDetails?
  address         Address?
  education       Education?
  occupation      Occupation?
  documents       Document[]

  applications Application[]
}

model OfficeProfile {
  id           String @id @default(cuid())
  userId       String @unique
  departmentId String

  jurisdictionLevel JurisdictionLevel

  provinceId     String?
  districtId     String?
  municipalityId String?
  wardId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [uid], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  province     Province?     @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  district     District?     @relation(fields: [districtId], references: [id], onDelete: Cascade)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  ward         Ward?         @relation(fields: [wardId], references: [id], onDelete: Cascade)

  schemes Scheme[]

  applicationAnswers ApplicationAnswer[]

  applications Application[]
}

model PersonalDetails {
  id        String @id @default(cuid())
  profileId String @unique

  fullName      String
  dateOfBirth   DateTime
  gender        Gender
  maritalStatus MaritalStatus
  fatherName    String
  motherName    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile CitizenProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Address {
  id        String @id @default(cuid())
  profileId String @unique

  provinceID     String
  districtID     String
  municipalityID String
  wardID         String
  tole           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  province     Province     @relation(fields: [provinceID], references: [id], onDelete: Cascade)
  district     District     @relation(fields: [districtID], references: [id], onDelete: Cascade)
  municipality Municipality @relation(fields: [municipalityID], references: [id], onDelete: Cascade)
  ward         Ward         @relation(fields: [wardID], references: [id], onDelete: Cascade)

  profile CitizenProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Education {
  id        String @id @default(cuid())
  profileId String @unique

  highestQualification String
  institutionName      String?
  graduationYear       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile CitizenProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Occupation {
  id        String @id @default(cuid())
  profileId String @unique

  occupationTitle  String
  employmentType   EmploymentType
  organizationName String?

  createdAt DateTime @default(now())

  profile CitizenProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Document {
  id        String @id @default(cuid())
  profileId String

  documentType   DocumentType
  documentNumber String
  issuedDate     DateTime

  frontImageUrl String
  backImageUrl  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile CitizenProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([documentType, documentNumber])
  @@index([profileId])
}

//////////////////////////////////////////////////////
// DEPARTMENTS
//////////////////////////////////////////////////////
model Department {
  id   String  @id @default(uuid())
  name String  @unique
  code String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officeProfile OfficeProfile[]
}

model Scheme {
  id String @id @default(cuid())

  title       String
  description String
  objectives  String?

  category SchemeCategory
  budget   Float

  status   SchemeStatus @default(DRAFT)
  isActive Boolean      @default(false)

  //Eligibility
  eligibilityCriteria String?
  minAge              Int?
  maxAge              Int?
  incomeLimit         Float?

  //Capacity control
  maxBeneficiaries Int?
  maxApplications  Int?

  startDate DateTime
  endDate   DateTime

  //Geography targeting
  provinceId     String?
  districtId     String?
  municipalityId String?
  wardId         String?

  //Creator
  createdById String
  createdBy   OfficeProfile @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Relations
  schemeRequirements SchemeRequirement[]
  applications       Application[]

  @@index([status])
  @@index([category])
}

model SchemeRequirement {
  id String @id @default(cuid())

  schemeId String
  scheme   Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  title       String
  description String?

  type                 RequirementType
  isMandatory          Boolean         @default(true)
  requiresVerification Boolean         @default(true)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  applicationAnswers ApplicationAnswer[]

  @@index([schemeId])
}

model Application {
  id String @id @default(cuid())

  schemeId String
  scheme   Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  applicantId String
  applicant   CitizenProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  status ApplicationStatus @default(SUBMITTED)

  provinceId     String?
  districtId     String?
  municipalityId String?
  wardId         String?

  submittedAt DateTime?
  reviewedAt  DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?

  reviewedById String?
  reviewedBy   OfficeProfile? @relation(fields: [reviewedById], references: [id], onDelete: Cascade)

  rejectionReason String?

  answers ApplicationAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([applicantId])
  @@index([schemeId])
}

model ApplicationAnswer {
  id String @id @default(cuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  requirementId String
  requirement   SchemeRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  textValue    String?
  numberValue  Float?
  dateValue    DateTime?
  booleanValue Boolean?
  documentUrl  String?

  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedBy         OfficeProfile?     @relation(fields: [verifiedById], references: [id], onDelete: Cascade)
  verifiedAt         DateTime?

  verificationRemarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([requirementId])
}
